# ========================================================
# PERSONAL AI PLATFORM - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=jdbc:postgresql://localhost:5432/personal_ai_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_secure_pass

# Redis Caching Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (JWT)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Models - Local Provider (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=llama3.2
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# AI Models - Cloud Providers (Optional)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# System Mode: LOCAL, CLOUD, HYBRID
AI_SYSTEM_MODE=HYBRID

# Web Search Tools
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# File Storage Configuration
STORAGE_ROOT_PATH=./data/documents

# Code Sandbox Container Configuration
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=10
